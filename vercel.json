{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    },
    {
      "source": "/documents/upload",
      "destination": "/api/index.py?__path__=/api/documents/upload"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__path__=/health"
    }
  ]
}

