{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__path__=/api/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__path__=/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

