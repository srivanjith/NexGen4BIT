# ==================================================
# GOVVERIFY BACKEND ENVIRONMENT EXAMPLE TEMPLATE
# ==================================================

# 1. DATABASE CONFIGURATION
# MongoDB Atlas Connection URI or Local MongoDB instance
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0
DATABASE_NAME=govverify

# 2. CORS & SECURITY CONFIGURATION
# Allowed origin URL for React frontend
FRONTEND_URL=http://localhost:5173
SECRET_KEY=replace_with_your_secure_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. FILE UPLOAD CONFIGURATION
UPLOADS_DIR=uploads
MAX_FILE_SIZE_MB=10

# 4. AI / ML MODEL CONFIGURATION
MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.50

# 5. OPTIONAL EXTERNAL INTEGRATIONS
# OPENAI_API_KEY=your_openai_api_key_here
