# =======================================================
# GOVVERIFY GLOBAL PROJECT ENVIRONMENT VARIABLES REFERENCE
# =======================================================

# -------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# -------------------------------------------------------

# 1. MongoDB Atlas Connection String & Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0
DATABASE_NAME=govverify

# 2. Security & CORS Origin
FRONTEND_URL=http://localhost:5173
SECRET_KEY=govverify_dev_secret_key_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. File Upload Limits & Storage Folder
UPLOADS_DIR=uploads
MAX_FILE_SIZE_MB=10

# 4. AI / ML Embedding Models & Thresholds
MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.50

# 5. Optional Integrations
# OPENAI_API_KEY=your_openai_api_key_here

# -------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# -------------------------------------------------------

# FastAPI Backend API Base URL
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=GovVerify